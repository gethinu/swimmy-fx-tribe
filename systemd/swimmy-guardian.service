[Unit]
Description=Swimmy Guardian Service (Rust)
Documentation=https://github.com/swimmy/swimmy
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=swimmy
Group=swimmy
WorkingDirectory=/home/swimmy/swimmy
# Phase 1: (disabled) pkill was killing backtest-only guardian and causing restart loops
# Phase 2: Wait for OS to release sockets
ExecStartPre=/bin/sleep 2
# Phase 3: Force-release ZMQ ports (5557=Guardian PUB)
ExecStartPre=-/usr/bin/fuser -k 5557/tcp
# Phase 4: Final cooldown
ExecStartPre=/bin/sleep 1
# Canonical build output: the root Cargo.toml declares a workspace, so
# `cargo build --release` writes to <repo>/target/release/guardian. Deploy is
# therefore a plain rebuild — never copy the binary into guardian/target/.
ExecStart=/home/swimmy/swimmy/target/release/guardian
StandardOutput=append:/home/swimmy/swimmy/logs/guardian.log
StandardError=append:/home/swimmy/swimmy/logs/guardian.log
Environment=HOME=/home/swimmy
EnvironmentFile=/home/swimmy/swimmy/.env
# Select on purged/embargoed train folds and expose the PBO used by the S gate.
Environment=SWIMMY_CPCV_REFIT=1
Environment=SWIMMY_CPCV_PBO=1
Environment=SWIMMY_BOOTSTRAP_MOVING_BLOCK=1
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=default.target
