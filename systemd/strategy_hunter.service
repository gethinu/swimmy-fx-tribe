[Unit]
Description=Swimmy Strategy Hunter
After=network.target
# Start rate limiting is parsed only in [Unit]; systemd drops these keys with an
# "Unknown key name ... ignoring" warning anywhere else.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/swimmy
ExecStart=/usr/bin/python3 %h/swimmy/tools/strategy_hunter.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/swimmy/logs/strategy_hunter.log
StandardError=append:%h/swimmy/logs/strategy_hunter.log

[Install]
WantedBy=default.target
